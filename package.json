{
  "name": "unilab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node supabase/tests/sql-verification.mjs",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:apply": "node --env-file=.env.local scripts/apply-schema.mjs",
    "db:apply-auth-lifecycle": "node --env-file=.env.local scripts/apply-auth-lifecycle.mjs",
    "test:auth-lifecycle": "node --env-file=.env.local supabase/tests/auth-lifecycle-verification.mjs",
    "test:ui": "node tests/ui/verify.mjs",
    "preview:ui": "vite --config tests/ui/vite.config.mts --host 127.0.0.1 --port 4178"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "resend": "^6.31.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  }
